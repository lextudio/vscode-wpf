<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows so WPF assemblies (PresentationFramework etc.) are available
         in the Roslyn compilation loaded from the target project. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>wpf-xaml-ls</AssemblyName>
    <RootNamespace>XamlLanguageServer.Wpf</RootNamespace>
    <!-- We ship a single framework-dependent, portable (no RID) build so it runs on
         any CPU architecture via `dotnet wpf-xaml-ls.dll`. R2R crossgens native code
         for whatever RID dotnet publish defaults to (the build machine's arch) when
         none is specified, which silently breaks on other architectures — so it must
         stay off unless a RID is explicitly supplied. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' == ''">false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- AXSG language service infrastructure (from submodule) -->
    <ProjectReference Include="..\..\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.LanguageService\XamlToCSharpGenerator.LanguageService.csproj" />
    <ProjectReference Include="..\..\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.LanguageServer\XamlToCSharpGenerator.LanguageServer.csproj" />
    <ProjectReference Include="..\..\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.Framework.Abstractions\XamlToCSharpGenerator.Framework.Abstractions.csproj" />
    <ProjectReference Include="..\..\external\wxsg\external\XamlToCSharpGenerator\src\XamlToCSharpGenerator.Core\XamlToCSharpGenerator.Core.csproj" />
    <ProjectReference Include="..\..\external\wxsg\src\XamlToCSharpGenerator.WPF\XamlToCSharpGenerator.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>XamlLanguageServer.Wpf.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Deploy the whole runnable server (dll + deps + runtimeconfig) into
       AddIns/LanguageServices/XamlLanguageServer.Wpf/ so a published OpenDevelop.app
       bundle carries it too - LspServerRegistry.CreateDefault probes this deployed
       location first, falling back to this project's own bin/ output (dev-mode
       source-tree layout) only when it's absent. -->
  <Target Name="DeployToAddIns" AfterTargets="Build">
    <ItemGroup>
      <LanguageServerOutput Include="$(TargetDir)**" />
    </ItemGroup>
    <Copy SourceFiles="@(LanguageServerOutput)" SkipUnchangedFiles="true"
          DestinationFiles="@(LanguageServerOutput->'$(MSBuildProjectDirectory)\..\..\..\..\AddIns\LanguageServices\XamlLanguageServer.Wpf\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
